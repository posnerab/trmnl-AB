<div class="layout layout--col layout--center gap--small">
  {% if next_zman and next_zman.size > 1 %}
    <span class="label label--small label--gray">NEXT ZMAN</span>
    <span class="value value--giga value--tnums" data-fit-value="true">{{ next_zman[1] }}</span>
    <span class="title title--medium">{{ next_zman[0] }}</span>
  {% else %}
    <span class="label label--small label--gray">NEXT ZMAN</span>
    <span class="title title--large">No upcoming zman</span>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">Next zman</span>
</div>