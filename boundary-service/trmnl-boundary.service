[Unit]
Description=Zmanim TRMNL transition images and wake scheduling
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xander
Group=xander
WorkingDirectory=/usr/local/lib/trmnl-boundary/boundary-service
Environment=NODE_ENV=production
Environment=PYTHONPATH=/home/xander/projects/shared
EnvironmentFile=-/etc/trmnl-boundary.env
ExecStart=/bin/bash /usr/local/lib/trmnl-boundary/boundary-service/start.sh
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
StateDirectory=trmnl-boundary
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/trmnl-boundary
MemoryMax=900M
TasksMax=256

[Install]
WantedBy=multi-user.target
